{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    },
    "SmartStandards": {
      //0=Trace, 1=Debug, 2=Information, 3=Warning, 4=Error, 5=Critical
      "ConsoleLogging": {
        "Enabled": true,
        "DefaultLogLevelFilter": 2
      },
      "FileLogging": {
        "Enabled": true,
        "DefaultLogLevelFilter": 0,
        "TargetFileName": "logs\\{application}-{timestamp:yyyy-MM-dd}.log"
      }
    }
  },
  "AllowedHosts": "*",
  "EnableSwaggerUi": true,
  "ProdMode": false,
  "BaseUrl": "/",
  "Mcp": {
    //Opt-in metadata-only MCP diagnostics (event kinds 75300-75399); the logging sink must accept Trace (0).
    "EnableDiagnosticTracing": false
  },
  "CalDav": {
    //absolute URL of the CalDAV calendar home collection, e.g. "https://<caldav-host>/<calendar-home-path>/"
    //(configure it in appsettings.Development.json or user secrets - never put credentials here!)
    "CalendarHomeUrl": "",
    "TimeoutSeconds": 30,
    //LOCAL TESTING ONLY: if 'MockToLocalDir' is not null, a local mock (persisting *.ics files) replaces the CalDAV server.
    //The full OAuth + MCP auth flow stays active; the login only accepts 'MockAuthUser'/'MockAuthPass'.
    //Example (appsettings.Development.json): "MockToLocalDir": "c:\\temp\\CalendarItems", "MockAuthUser": "demo", "MockAuthPass": "..."
    "MockToLocalDir": "c:\\temp\\CalendarItems",
    "MockAuthUser": "demo",
    "MockAuthPass": "geheim"
  },
  "OAuth": {
    //if not empty: access grants, refresh grants and client registrations are persisted (encrypted via ASP.NET Data Protection,
    //they contain the CalDAV credentials!) into this directory, so logins of MCP clients survive a restart
    "PersistToDir": "c:\\temp\\OAuthState"
  }
}
